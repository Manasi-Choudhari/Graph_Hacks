# FraudScope AI — Environment Config
# Copy this file to .env and fill in your actual API keys

# ── LLM Provider ─────────────────────────────────────────────
# Which LLM to use: "groq" or "gemini"
LLM_PROVIDER=groq

# Get your Groq key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Get your Gemini key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ── FalkorDB ──────────────────────────────────────────────────
# Run FalkorDB with: docker run -p 6379:6379 falkordb/falkordb:latest
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── App Settings ──────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
DEBUG=true
